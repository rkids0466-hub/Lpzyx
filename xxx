local function createToggle(name, default, callback)
    local container = Instance.new("TextButton")
    container.Size = UDim2.new(1, -6, 0, 28)
    container.BackgroundColor3 = Color3.fromRGB(22, 18, 30)
    container.BackgroundTransparency = 0.3
    container.AutoButtonColor = false
    container.Text = ""
    container.Parent = ScrollingFrame
    
    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(0, 6)
    cCorner.Parent = container
    
    local cStroke = Instance.new("UIStroke")
    cStroke.Color = Color3.fromRGB(50, 40, 70)
    cStroke.Thickness = 1
    cStroke.Parent = container
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -45, 1, 0)
    label.Position = UDim2.new(0, 8, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(240, 240, 255)
    label.TextSize = 11
    label.Font = Enum.Font.GothamSemibold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Parent = container
    
    local switchBg = Instance.new("Frame")
    switchBg.Size = UDim2.new(0, 32, 0, 16)
    switchBg.Position = UDim2.new(1, -38, 0.5, -8)
    switchBg.BackgroundColor3 = default and Color3.fromRGB(140, 40, 220) or Color3.fromRGB(40, 35, 50)
    switchBg.BorderSizePixel = 0
    switchBg.Parent = container
    
    local sbCorner = Instance.new("UICorner")
    sbCorner.CornerRadius = UDim.new(1, 0)
    sbCorner.Parent = switchBg
    
    local switchKnob = Instance.new("Frame")
    switchKnob.Size = UDim2.new(0, 12, 0, 12)
    switchKnob.Position = default and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    switchKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    switchKnob.BorderSizePixel = 0
    switchKnob.Parent = switchBg
    
    local skCorner = Instance.new("UICorner")
    skCorner.CornerRadius = UDim.new(1, 0)
    skCorner.Parent = switchKnob
    
    local state = default
    
    local function toggleAction()
        state = not state
        if state then
            switchBg.BackgroundColor3 = Color3.fromRGB(140, 40, 220)
            switchKnob:TweenPosition(UDim2.new(1, -14, 0.5, -6), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        else
            switchBg.BackgroundColor3 = Color3.fromRGB(40, 35, 50)
            switchKnob:TweenPosition(UDim2.new(0, 2, 0.5, -6), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        end
        callback(state)
    end
    
    container.MouseButton1Click:Connect(toggleAction)
end

