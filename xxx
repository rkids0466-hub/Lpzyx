local ESPInstances = {}

local function removeESP(player)
    if ESPInstances[player] then
        for _, obj in pairs(ESPInstances[player]) do
            pcall(function() 
                if typeof(obj) == "table" then
                    for _, line in pairs(obj) do
                        pcall(function() line:Remove() end)
                    end
                else
                    obj:Remove() 
                end
            end)
        end
        ESPInstances[player] = nil
    end
end

RunService.RenderStepped:Connect(function()
    local currentColor = ESPConfig.Color
    if currentColor == "Rainbow" then
        currentColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
    end

    if ESPConfig.DisplayPC then
        Camera.FieldOfView = 90
    end

    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if ESPConfig.Spin and rootPart then
        local currentCFrame = rootPart.CFrame
        rootPart.CFrame = currentCFrame * CFrame.Angles(0, math.rad(50), 0)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not ESPInstances[player] then
                pcall(function()
                    ESPInstances[player] = {
                        Box = Drawing.new("Square"),
                        Line = Drawing.new("Line"),
                        Skeleton = {
                            Head_Neck = Drawing.new("Line"),
                            Neck_Spine = Drawing.new("Line"),
                            Spine_Root = Drawing.new("Line"),
                            LeftShoulder = Drawing.new("Line"),
                            LeftArm = Drawing.new("Line"),
                            LeftHand = Drawing.new("Line"),
                            RightShoulder = Drawing.new("Line"),
                            RightArm = Drawing.new("Line"),
                            RightHand = Drawing.new("Line"),
                            LeftHip = Drawing.new("Line"),
                            LeftLeg = Drawing.new("Line"),
                            LeftFoot = Drawing.new("Line"),
                            RightHip = Drawing.new("Line"),
                            RightLeg = Drawing.new("Line"),
                            RightFoot = Drawing.new("Line")
                        }
                    }
                    ESPInstances[player].Box.Filled = false
                end)
            end
            
            local esp = ESPInstances[player]
            if esp then
                local character = player.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                
                if ESPConfig.Enabled and character and hrp and humanoid and humanoid.Health > 0 then
                    local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    
                    if onScreen then
                        local head = character:FindFirstChild("Head")
                        local upperTorso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
                        local lowerTorso = character:FindFirstChild("LowerTorso") or upperTorso
                        local humanoidRootPart = hrp
                        
                        local lArm1 = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
                        local lArm2 = character:FindFirstChild("LeftLowerArm") or lArm1
                        local lArm3 = character:FindFirstChild("LeftHand") or lArm2
                        
                        local rArm1 = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
                        local rArm2 = character:FindFirstChild("RightLowerArm") or rArm1
                        local rArm3 = character:FindFirstChild("RightHand") or rArm2
                        
                        local lLeg1 = character:FindFirstChild("LeftUpperLeg") or character:FindFirstChild("Left Leg")
                        local lLeg2 = character:FindFirstChild("LeftLowerLeg") or lLeg1
                        local lLeg3 = character:FindFirstChild("LeftFoot") or lLeg2
                        
                        local rLeg1 = character:FindFirstChild("RightUpperLeg") or character:FindFirstChild("Right Leg")
                        local rLeg2 = character:FindFirstChild("RightLowerLeg") or rLeg1
                        local rLeg3 = character:FindFirstChild("RightFoot") or rLeg2

                        local topPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        
                        local height = math.abs(topPos.Y - legPos.Y)
                        local width = height / 2
                        local boxPos = Vector2.new(vector.X - width / 2, topPos.Y)
                        
                        if ESPConfig.Box then
                            esp.Box.Visible = true
                            esp.Box.Size = Vector2.new(width, height)
                            esp.Box.Position = boxPos
                            esp.Box.Color = currentColor
                            esp.Box.Thickness = ESPConfig.Size
                        else
                            esp.Box.Visible = false
                        end
                        
                        if ESPConfig.Line then
                            esp.Line.Visible = true
                            esp.Line.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
                            esp.Line.To = Vector2.new(boxPos.X + (width / 2), boxPos.Y)
                            esp.Line.Color = currentColor
                            esp.Line.Thickness = ESPConfig.Size
                        else
                            esp.Line.Visible = false
                        end

                        if ESPConfig.Skeleton and head and upperTorso then
                            local function drawBone(boneObj, partA, partB)
                                if partA and partB then
                                    local posA, visA = Camera:WorldToViewportPoint(partA.Position)
                                    local posB, visB = Camera:WorldToViewportPoint(partB.Position)
                                    if visA or visB then
                                        boneObj.Visible = true
                                        boneObj.From = Vector2.new(posA.X, posA.Y)
                                        boneObj.To = Vector2.new(posB.X, posB.Y)
                                        boneObj.Color = Color3.fromRGB(255, 255, 255)
                                        boneObj.Thickness = ESPConfig.Size
                                        return
                                    end
                                end
                                boneObj.Visible = false
                            end

                            drawBone(esp.Skeleton.Head_Neck, head, upperTorso)
                            drawBone(esp.Skeleton.Neck_Spine, upperTorso, lowerTorso)
                            drawBone(esp.Skeleton.Spine_Root, lowerTorso, humanoidRootPart)

                            drawBone(esp.Skeleton.LeftShoulder, upperTorso, lArm1)
                            drawBone(esp.Skeleton.LeftArm, lArm1, lArm2)
                            drawBone(esp.Skeleton.LeftHand, lArm2, lArm3)

                            drawBone(esp.Skeleton.RightShoulder, upperTorso, rArm1)
                            drawBone(esp.Skeleton.RightArm, rArm1, rArm2)
                            drawBone(esp.Skeleton.RightHand, rArm2, rArm3)

                            drawBone(esp.Skeleton.LeftHip, lowerTorso, lLeg1)
                            drawBone(esp.Skeleton.LeftLeg, lLeg1, lLeg2)
                            drawBone(esp.Skeleton.LeftFoot, lLeg2, lLeg3)

                            drawBone(esp.Skeleton.RightHip, lowerTorso, rLeg1)
                            drawBone(esp.Skeleton.RightLeg, rLeg1, rLeg2)
                            drawBone(esp.Skeleton.RightFoot, rLeg2, rLeg3)
                        else
                            for _, bone in pairs(esp.Skeleton) do
                                bone.Visible = false
                            end
                        end
                    else
                        esp.Box.Visible = false
                        esp.Line.Visible = false
                        for _, bone in pairs(esp.Skeleton) do
                            bone.Visible = false
                        end
                    end
                else
                    esp.Box.Visible = false
                    esp.Line.Visible = false
                    for _, bone in pairs(esp.Skeleton) do
                        bone.Visible = false
                    end
                end
            end
        end
    end
end)
